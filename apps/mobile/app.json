{
  "expo": {
    "name": "Growlog AI",
    "slug": "growlog-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "growlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.growlog.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Growlog uses the camera for grow photos.",
        "NSMicrophoneUsageDescription": "Growlog records voice logs.",
        "NSPhotoLibraryUsageDescription": "Growlog saves and uploads grow photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "ai.growlog.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Growlog to record voice logs."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Growlog to upload grow photos.",
          "cameraPermission": "Allow Growlog to capture grow photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2d6a4f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
